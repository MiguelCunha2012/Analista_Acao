<?xml version="1.0" encoding="utf-8" ?>
<!--
  Controle segmentado reutilizável (1D | 5D | 1M | 1A ...).
  Usado como filtro GLOBAL no Dashboard e LOCAL na página de detalhes.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AnalistaAcao.Models"
             xmlns:controls="clr-namespace:AnalistaAcao.Controls"
             x:Class="AnalistaAcao.Controls.TimeRangeSelector"
             x:DataType="controls:TimeRangeSelector"
             x:Name="Root">

    <Border Style="{StaticResource SegmentContainer}" HorizontalOptions="Start">
        <HorizontalStackLayout Spacing="2"
                               BindableLayout.ItemsSource="{Binding ItemsSource, Source={x:Reference Root}}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="models:TimeRangeOption">
                    <Button Text="{Binding Label}"
                            Style="{StaticResource SegmentButton}"
                            CommandParameter="{Binding .}"
                            Command="{Binding Command, Source={RelativeSource AncestorType={x:Type controls:TimeRangeSelector}}, x:DataType=controls:TimeRangeSelector}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Brand}" />
                                <Setter Property="TextColor" Value="{StaticResource OnBrand}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </HorizontalStackLayout>
    </Border>
</ContentView>
