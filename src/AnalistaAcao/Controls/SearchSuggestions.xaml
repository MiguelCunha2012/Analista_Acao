<?xml version="1.0" encoding="utf-8" ?>
<!--
  Lista de sugestões da busca.
  Não fica dentro da NavBar porque o Shell.TitleView corta tudo o que passa da altura
  da barra. Por isso é uma camada no topo de cada página (ControlTemplate "PageFrame"
  em Styles.xaml), alinhada à caixa de busca pelo code-behind.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AnalistaAcao.Models"
             xmlns:vm="clr-namespace:AnalistaAcao.ViewModels"
             x:Class="AnalistaAcao.Controls.SearchSuggestions"
             x:DataType="vm:ShellViewModel"
             IsVisible="{Binding IsSuggestionsOpen}"
             WidthRequest="380"
             HorizontalOptions="End"
             VerticalOptions="Start"
             Margin="0,6,16,0">

    <Border Style="{StaticResource Card}" Padding="6">
        <Border.Shadow>
            <Shadow Brush="#000000" Opacity="0.28" Radius="18" Offset="0,8" />
        </Border.Shadow>

        <VerticalStackLayout Spacing="2">

            <VerticalStackLayout Spacing="2" BindableLayout.ItemsSource="{Binding Suggestions}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:StockSuggestion">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="8,7">
                            <Grid.Triggers>
                                <DataTrigger TargetType="Grid" Binding="{Binding IsHighlighted}" Value="True">
                                    <Setter Property="BackgroundColor"
                                            Value="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}" />
                                </DataTrigger>
                            </Grid.Triggers>

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    CommandParameter="{Binding .}"
                                    Command="{Binding OpenSuggestionCommand, Source={RelativeSource AncestorType={x:Type vm:ShellViewModel}}, x:DataType=vm:ShellViewModel}" />
                                <PointerGestureRecognizer
                                    PointerEnteredCommandParameter="{Binding .}"
                                    PointerEnteredCommand="{Binding HighlightSuggestionCommand, Source={RelativeSource AncestorType={x:Type vm:ShellViewModel}}, x:DataType=vm:ShellViewModel}" />
                            </Grid.GestureRecognizers>

                            <Border Style="{StaticResource Avatar}" WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                                <Label Text="{Binding Stock.Initials}" Style="{StaticResource AvatarText}" FontSize="12" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                                <Label Text="{Binding Stock.Symbol}" FontSize="14" FontAttributes="Bold" />
                                <Label Text="{Binding Stock.Name}" Style="{StaticResource Caption}"
                                       LineBreakMode="TailTruncation" MaxLines="1" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="0">
                                <Label Text="{Binding Stock.PriceText}" FontSize="13" FontAttributes="Bold"
                                       HorizontalOptions="End" />
                                <Label Text="{Binding Stock.ChangeText}" FontSize="12" FontAttributes="Bold"
                                       HorizontalOptions="End"
                                       TextColor="{AppThemeBinding Light={StaticResource GainLight}, Dark={StaticResource GainDark}}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Stock.IsPositive}" Value="False">
                                            <Setter Property="TextColor"
                                                    Value="{AppThemeBinding Light={StaticResource LossLight}, Dark={StaticResource LossDark}}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Text="Nenhuma ação encontrada" Style="{StaticResource Muted}"
                   IsVisible="{Binding HasNoMatches}"
                   HorizontalOptions="Center" Margin="0,14" />

            <Label Text="↑↓ navegar  ·  Enter abrir  ·  Esc fechar" Style="{StaticResource Caption}" FontSize="11"
                   IsVisible="{OnPlatform WinUI=True, Default=False}"
                   HorizontalOptions="End" Margin="8,4,8,2" />
        </VerticalStackLayout>
    </Border>
</ContentView>
